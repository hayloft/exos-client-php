  "paths": {
    "/v1.0/timeZones": {
      "get": {
        "tags": [
          "time zone"
        ],
        "summary": "get a list of time zones with the specific filters",
        "description": "Be aware that a query made here can return up to 10000 records. If you need more, please use the built in paging functionality with $top and $skip.\nhttp://www.asp.net/web-api/overview/odata-support-in-aspnet-web-api/supporting-odata-query-options. ",
        "parameters": [
          {
            "name": "$expand",
            "in": "query",
            "description": "",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "$filter",
            "in": "query",
            "description": "",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "searchString",
            "in": "query",
            "description": "Fulltext search on all string, int and date fields that are selected with $select and $expand.",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "accessRightId",
            "in": "query",
            "description": "Id of the access right. Limits the output to all the time zones assignable to this access right.",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "accessDomainId",
            "in": "query",
            "description": "Id of the access domain. Limits the output to all the time zones assignable to this access domain.",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "accessRightType",
            "in": "query",
            "description": "Type of the access right. Limits the output to all the time zones assignable to this access right type.",
            "schema": {
              "$ref": "#/components/schemas/AccessRightType",
              "nullable": true
            }
          },
          {
            "name": "$count",
            "in": "query",
            "description": "adds total possible results to the response",
            "schema": {
              "type": "boolean",
              "default": true,
              "nullable": true
            }
          },
          {
            "name": "$orderby",
            "in": "query",
            "description": "",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "$select",
            "in": "query",
            "description": "",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "$skip",
            "in": "query",
            "description": "skips the first x entries of the response(paging)",
            "schema": {
              "type": "integer",
              "nullable": true
            }
          },
          {
            "name": "$top",
            "in": "query",
            "description": "limits the number of returned records.",
            "schema": {
              "type": "integer",
              "default": 1000,
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTimeZoneOutputWithTime"
                }
              }
            }
          }
        },
        "x-rights": "API_AC_TimeZonesRead",
        "x-errorcodes": "300004,300008,999999"
      }
    }
  },
