          "API_CM_ContractorReportCreate"
        ],
        "x-errorcodes": "100000,100001,100002,100005,100009,300004,300008,400001,400139,999999"
      }
    },
    "/v1.0/personReports/settings/MaximumReportSize": {
      "post": {
        "tags": [
          "person report"
        ],
        "summary": "expression that defines the MaximumReportSizeInBytes parameter",
        "description": "Default 8388608, valid length: 0-2147483647. ",
        "requestBody": {
          "description": "set parameter value",
          "content": {
