    "/v1.0/personReports/create": {
      "post": {
        "tags": [
          "person report"
        ],
        "summary": "Save a report for a specific person.",
        "description": "Saves a (signed) report for a specific person.<br />The report must be passed as base64 encoded string.<br />The report size is limited to 8MB per default and can be controlled with the Parameter SYS/MAXPERSONREPORTSIZEINBYTE.<br />.",
