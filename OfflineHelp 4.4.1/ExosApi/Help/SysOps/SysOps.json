    "/v1.0/{id}/command/{command}": {
      "post": {
        "tags": [
          "SysOps"
        ],
        "summary": "execute a command for a device",
        "description": "execute a command for a device",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "id of the periphery (devicetype + internalId of the specific periphery (example: CommunicationHub with Id 1 => FS1, AMX with Id 113 => SS113))",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "command",
            "in": "path",
            "description": "The command to be executed on the device",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "Block",
                "BlockTimeLimited",
                "AccessProfileCheck",
                "NormalOperation",
                "ReleaseTimeLimited",
                "ReleasePermanently",
                "ReleaseOnce",
                "ReleaseSide1",
                "ReleaseSide2",
                "LoadParameters",
                "LoadData",
                "LoadAccessProfiles",
                "LoadUserMediaAndAccessProfiles",
                "BootRestart",
                "PortConnect",
                "PortDisconnect",
                "Initialize",
                "StartCommissioning",
                "StopCommissioning",
                "LeaveNetwork",
                "SetOn",
                "SetOff",
                "SetDefault",
                "LoadPrograms",
                "UpdateState",
                "LoadToProgrammer",
                "StandaloneShowConfiguration",
                "ImportFromProgrammerSyncronize",
                "ToggleActivation",
                "ShowPlannedProfiles",
                "ShowAccesslog",
                "ShowAlarmlog",
                "ShowAuditlog",
                "ShowDownlog",
                "Delete",
                "LoadToProgrammerMultiple",
                "LoadAccessRights",
                "BusKeyPackageGet",
                "BusKeyPackageGetNoTls",
                "BusKeyPackageSet",
                "BusKeyPackageSetNoTls"
              ]
            }
          },
          {
            "name": "time",
            "in": "query",
            "description": "The time the command shall be executed (in minutes)",
            "schema": {
              "type": "integer",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecuteCommandOutputWithTime"
                }
              }
            }
          }
        },
        "x-rights": "API_SYSOPS_ExecuteCommand",
        "x-errorcodes": "100000,300004,300008,400213,400214,400215,400219,400220,400221,999999"
      }
    },
    "/v1.0/peripheryStatusList": {
      "get": {
        "tags": [
          "SysOps"
        ],
        "summary": "gets the devices",
        "description": "gets the devices",
        "parameters": [
          {
            "name": "componentType",
            "in": "query",
            "description": "type of component",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "Undefined",
                "Online",
                "Standalone"
              ]
            }
          },
          {
            "name": "skip",
            "in": "query",
            "description": "Define at which element to start with. Default 0",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "nullable": true
            }
          },
          {
            "name": "take",
            "in": "query",
            "description": "Define the size of items you want to get. Default 30 (restriction max 80)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 30,
              "nullable": true
            }
          },
          {
            "name": "orderBy",
            "in": "query",
            "description": "Define the order",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/peripheryOrderBy"
            }
          },
          {
            "name": "searchString",
            "in": "query",
            "description": "search in device name or device address (Searchlogic: searchstring% -> startswith, %searchstring -> endswith, all other combinations -> contains)",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "filterByDeviceType",
            "in": "query",
            "description": "filter the data by device type (equal)",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/deviceTypes"
            }
          },
          {
            "name": "filterDevicesWithAlarm",
            "in": "query",
            "description": "filter the devices with alarm (false = all devices / true = devices not running)",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/device"
                }
              }
            }
          }
        },
        "x-rights": [
          "",
          ""
        ],
        "x-errorcodes": ""
      }
    },
