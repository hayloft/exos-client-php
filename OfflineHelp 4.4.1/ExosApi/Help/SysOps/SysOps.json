    "/v1.0/recalculateTreepaths": {
      "post": {
        "tags": [
          "SysOps"
        ],
        "summary": "triggers the recalculation of flagged periphery treepaths",
        "description": "triggers the recalculation of flagged periphery treepaths",
        "parameters": [
          {
            "name": "wait",
            "in": "query",
            "description": "Defines whether we wait for calculation to finish",
            "schema": {
              "type": "boolean",
              "nullable": true,
              "default": false
            }
          },
          {
            "name": "forceUpdateDataStore",
            "in": "query",
            "description": "if true, will also force an update on the inMemory tree store (any detected changes will result in an update of the store irrespective of this param)",
            "schema": {
              "type": "boolean",
              "nullable": true,
              "default": false
            }
