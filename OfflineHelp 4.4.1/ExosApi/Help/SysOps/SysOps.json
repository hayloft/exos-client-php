  "components": {
    "schemas": {
      "GetCommandsOutputWithTime": {
        "required": [
          "TimeElapsed",
          "Value"
        ],
        "properties": {
          "TimeElapsed": {
            "type": "integer"
          },
          "Value": {
            "$ref": "#/components/schemas/GetCommandsOutput"
          }
        }
      },
      "GetCommandsOutput": {
        "required": [
          "Commands"
        ],
        "properties": {
          "Commands": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        }
      },
      "ExecuteCommandOutputWithTime": {
        "required": [
          "TimeElapsed"
        ],
        "properties": {
          "TimeElapsed": {
            "type": "integer"
          },
          "Value": {
            "$ref": "#/components/schemas/ExecuteCommandOutput"
          }
        }
      },
      "ExecuteCommandOutput": {
        "properties": {
          "LogInformation": {
            "$ref": "#/components/schemas/LogInformationOutput"
          }
        }
      },
      "LogInformationOutput": {
        "properties": {
          "AlarmlogDeviceAddress": {
            "type": "string",
            "default": "",
            "nullable": true
          },
          "AlarmlogDataPointType": {
            "type": "string",
            "default": "",
            "nullable": true
          },
          "AccesslogDeviceAddresses": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        }
      },
      "VoidResponseOutput": {
        "required": [
          "TimeElapsed"
        ],
        "properties": {
          "TimeElapsed": {
            "type": "integer"
          }
        }
      },
      "node": {
        "required": [
          "Value"
        ],
        "properties": {
          "Value": {
            "properties": {
              "Nodes": {
                "type": "array",
                "items": {
                  "required": [
                    "Id",
                    "DeviceAddress",
                    "DeviceType",
                    "TreePath"
                  ],
                  "properties": {
                    "Id": {
                      "type": "string",
                      "default": "",
                      "nullable": false
                    },
                    "Name": {
                      "type": "string",
                      "default": "",
                      "nullable": true
                    },
                    "DeviceAddress": {
                      "type": "string",
                      "default": "",
                      "nullable": true
                    },
                    "DeviceType": {
                      "$ref": "#/components/schemas/deviceTypes"
                    },
                    "SubstatType": {
                      "$ref": "#/components/schemas/substationTypes"
                    },
                    "DoorType": {
                      "$ref": "#/components/schemas/doorTypes"
                    },
                    "OperationalMode": {
                      "$ref": "#/components/schemas/operationalModes"
                    },
                    "TreePath": {
                      "type": "string",
                      "default": "",
                      "nullable": false
                    },
                    "TreeLevel": {
                      "type": "integer",
                      "format": "int16",
                      "default": 1,
                      "nullable": true
                    },
                    "State": {
                      "type": "integer",
                      "format": "int16",
                      "default": 1,
                      "nullable": true
                    },
                    "UnderlayingNodesInErrorState": {
                      "type": "boolean",
                      "default": false,
                      "nullable": false
                    },
                    "Mode": {
                      "type": "integer",
                      "format": "int16",
                      "default": 0,
                      "nullable": true
                    },
                    "Activated": {
                      "type": "boolean",
                      "default": false,
                      "nullable": true
                    },
