          },
          {
            "name": "componentType",
            "in": "query",
            "description": "type of component",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "Undefined",
                "Online",
                "Standalone"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/node"
                }
              }
            }
          }
        },
        "x-rights": "",
        "x-errorcodes": "400212,400215,400221"
