  "components": {
    "schemas": {
      "GetExportListResponse": {
        "required": [
          "TimeElapsed",
          "Value"
        ],
        "properties": {
          "Value": {
            "$ref": "#/components/schemas/GetExportListOutput"
          },
          "TimeElapsed": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "GetExportListOutput": {
        "required": [
          "Exports"
        ],
        "properties": {
          "Exports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExportItem"
            }
          }
        }
      },
      "ExportItem": {
        "required": [
          "Identifier",
          "Created",
          "Status"
        ],
        "properties": {
          "Identifier": {
            "type": "string"
          },
          "Created": {
            "type": "string",
            "format": "date-time",
            "example": "2001-01-31T11:55:00"
          },
          "Status": {
            "type": "string",
            "enum": [
              "New",
              "InProgress",
              "Error",
              "Ready",
              "Downloaded"
            ]
          },
          "ErrorMessage": {
            "type": "string",
            "nullable": true
          },
          "Filename": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ExportResponse": {
        "required": [
          "TimeElapsed",
          "Value"
        ],
        "properties": {
          "Value": {
            "$ref": "#/components/schemas/ExportItem"
          },
          "TimeElapsed": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "ExportFormat": {
        "enum": [
          "CSV",
          "PDF"
        ],
        "type": "string",
        "default": "CSV"
      },
      "PersonType": {
        "enum": [
          "All",
          "Employee",
          "Visitor",
          "Contractor"
        ],
        "type": "string",
        "default": "All",
        "nullable": true
      }
    },
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
