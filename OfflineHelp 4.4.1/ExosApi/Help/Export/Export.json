{
  "openapi": "3.0.1",
  "info": {
    "title": "exos API",
    "version": "4.4.01"
  },
  "servers": [
    {
      "url": "/ExosApi/api"
    }
  ],
  "paths": {
    "/v1.0/export/list-own/{viewName}": {
      "get": {
        "tags": [
          "export"
        ],
        "summary": "Get my own exports of a given view.",
        "description": "Gets the list of existing data exports that were requested by the current user from the given application view.",
        "parameters": [
          {
            "name": "viewName",
            "in": "path",
            "description": "name of the application view",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetExportListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1.0/export/{exportId}/download": {
      "get": {
        "tags": [
          "export"
        ],
        "summary": "Download export by its identifier.",
        "description": "Gets the contents of the file with the exported data corresponding to the given export identifier.",
        "parameters": [
          {
            "name": "exportId",
            "in": "path",
            "description": "export identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        },
        "x-errorcodes": "400230"
      }
    },
    "/v1.0/export/{exportId}/delete": {
      "post": {
        "tags": [
          "export"
        ],
        "summary": "Delete export data by its identifier.",
        "description": "Deletes from the server all data corresponding to the given export identifier.",
        "parameters": [
          {
            "name": "exportId",
            "in": "path",
            "description": "export identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success"
          }
        },
        "x-errorcodes": "400230"
      }
    },
    "/v1.0/export/persons": {
      "get": {
        "tags": [
          "export"
        ],
        "summary": "Generate the person export.",
        "description": "Starts the generation of the person export in the background.",
        "parameters": [
          {
            "name": "viewName",
            "in": "query",
            "description": "name of the application view",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "columnsString",
            "in": "query",
            "description": "columns to be displayed in the export (separated by a comma)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fileName",
            "in": "query",
            "description": "name of the export file",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "exportFormat",
            "in": "query",
            "description": "format of the export file",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ExportFormat"
            }
          },
          {
            "name": "title",
            "in": "query",
            "description": "title for the pdf export",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "personType",
            "in": "query",
            "description": "the person type",
            "schema": {
              "$ref": "#/components/schemas/PersonType"
            }
          },
          {
            "name": "$expand",
            "in": "query",
            "description": "PersonBaseData($select=LastName,FirstName)",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "$filter",
            "in": "query",
            "description": "startswith(PersonBaseData/LastName,'a')",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "searchString",
            "in": "query",
            "description": "Fulltext search on all string, int and date fields that are selected with $select and $expand.",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "$count",
            "in": "query",
            "description": "adds total possible results to the response",
            "schema": {
              "type": "boolean",
              "default": true,
              "nullable": true
            }
          },
          {
            "name": "$orderby",
            "in": "query",
            "description": "PersonBaseData/LastName desc",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "$select",
            "in": "query",
            "description": "PersonId,ClientId",
            "required": true,
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "searchStringLogic",
            "in": "query",
            "description": "Logic that is to be applied to the search string. If no value is provided: 'SelectedFields' is applied. ('SelectedFields': Filter in fields provided in the select/expand clause, 'BasicFields': filter only in fullname, personal nr, badge filtering, 'PersonalNumberOnly': only filter in personal number)",
            "schema": {
              "enum": [
                "SelectedFields",
                "BasicFields",
                "PersonalNumberOnly"
              ],
              "type": "string",
              "default": "SelectedFields",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportResponse"
                }
              }
            }
          }
        },
        "x-errorcodes": "300004,300008,999999"
      }
    },
