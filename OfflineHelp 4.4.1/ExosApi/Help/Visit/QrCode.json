                "schema": {
                  "$ref": "#/components/schemas/GetQrCodeVisitorSettingsOutputWithTime"
                }
              }
            }
          }
        },
        "x-rights": "API_VM_QrCodeSettingsRead",
        "x-errorcodes": "100000,100001,300004,300008,400107,999999"
      },
      "post": {
        "tags": [
          "qrcode"
        ],
        "summary": "sets the qr code settings for visitor management",
        "description": "sets the qr code settings for visitor management",
        "parameters": [
          {
            "name": "workstation",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "setting values",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetQrCodeVisitorSettingsInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoidResponseOutput"
                }
              }
            }
          }
        },
        "x-rights": "API_VM_QrCodeSettingsUpdate",
        "x-errorcodes": "100000,100001,100004,300004,300008,400010,400017,400107,400179,400180,999999"
      }
    },
    "/v1.0/qrCode/cleanQrCodes": {
      "post": {
        "tags": [
          "qrcode"
        ],
        "summary": "clean up job for qr codes",
        "description": "removes passed qr codes from the system",
        "requestBody": {
          "description": "setting values",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CleanQrCodeInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoidResponseOutput"
                }
              }
            }
          }
        },
        "x-rights": "TO be defined (same as error codes)",
        "x-errorcodes": "100000,100001,300004,300008,999999"
      }
    }
