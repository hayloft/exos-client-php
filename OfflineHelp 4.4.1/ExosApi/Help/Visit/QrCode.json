      "get": {
        "tags": [
          "qrcode"
        ],
        "summary": "gets the qr code settings for visitor management",
        "description": "gets the qr code settings for visitor management",
        "parameters": [
          {
            "name": "workstation",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
