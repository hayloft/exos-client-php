{
  "openapi": "3.0.1",
  "info": {
    "title": "exos API",
    "version": "4.4.01"
  },
  "servers": [
    {
      "url": "/ExosApi/api"
    }
  ],
  "paths": {
    "/v1.0/functions": {
      "get": {
        "tags": [
          "function"
        ],
        "summary": "get a list of functions by odata query options",
        "description": "Be aware that a query made here can return up to 10000 records. If you need more, please use the built in paging functionality with $top and $skip.<br /> http://www.asp.net/web-api/overview/odata-support-in-aspnet-web-api/supporting-odata-query-options. <br /> The provided searchString will result in a fulltext search on all selected fields. If the passed value is encapsulated with quotes(\"), it will be treated as an exact match search, otherwise the passed value will be an OR search over all keywords(splitted by space character). ",
        "parameters": [
          {
            "name": "$expand",
            "in": "query",
            "description": "no expand",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "$filter",
            "in": "query",
            "description": "FunctionType eq 'Visit'",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "searchString",
            "in": "query",
            "description": "Fulltext search on all string, int and date fields that are selected with $select.",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "$count",
            "in": "query",
            "description": "adds total possible results to the response",
            "schema": {
              "type": "boolean",
              "default": true,
              "nullable": true
            }
          },
          {
            "name": "$orderby",
            "in": "query",
            "description": "FunctionName desc",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "$select",
            "in": "query",
            "description": "FunctionName",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "$skip",
            "in": "query",
            "description": "skips the first x entries of the response(paging)",
            "schema": {
              "type": "integer",
              "nullable": true
            }
          },
          {
            "name": "$top",
            "in": "query",
            "description": "limits the number of returned records.",
            "schema": {
              "type": "integer",
              "default": 1000,
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFunctionsOutput"
                }
              }
            }
          }
        },
        "x-rights": "",
        "x-errorcodes": "300004,300008,999999"
      }
    }
  },
  "components": {
    "schemas": {
      "GetFunctionsOutput": {
        "required": [
          "value"
        ],
        "properties": {
          "@odata.count": {
            "type": "integer",
            "format": "int32",
            "default": 1,
            "nullable": true
          },
          "value": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetFunctionEntryOutput"
            }
          }
        }
      },
      "GetFunctionEntryOutput": {
        "properties": {
          "FunctionIdInternal": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "FunctionId": {
            "type": "string",
            "default": "",
            "nullable": true
          },
          "FunctionType": {
            "type": "string",
            "default": "",
            "nullable": true
          },
          "FunctionName": {
            "type": "string",
            "default": "",
            "nullable": true
          },
          "FunctionText": {
            "type": "string",
            "default": "",
            "nullable": true
          }
        }
      }
    },
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "function",
      "description": ""
    }
  ]
}