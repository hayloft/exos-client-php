      "get": {
        "tags": [
          "timeReports"
        ],
        "summary": "gets the presence time for a person in a specific period",
        "description": "",
        "parameters": [
          {
            "name": "personId",
            "in": "path",
            "description": "The personId",
            "required": true,
            "schema": {
              "type": "string"
