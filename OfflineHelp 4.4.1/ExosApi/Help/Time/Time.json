  "components": {
    "schemas": {
      "CreateTimeRegistrationInput": {
        "required": [
          "RegistrationTime",
          "Value"
        ],
        "properties": {
          "RegistrationTime": {
            "type": "string",
            "format": "date-time",
            "example": "2001-01-31T11:55:00"
          },
          "RegistrationType": {
            "enum": [
              "Come",
              "Go"
            ],
            "type": "string",
            "default": "Come",
            "nullable": true
          }
        }
      },
      "SetEndOfDayInput": {
        "required": [
          "EndOfDayInMinutes"
        ],
        "properties": {
          "EndOfDayInMinutes": {
            "type": "integer",
            "format": "int32",
            "nullable": false
          },
          "Date": {
            "type": "string",
            "format": "date",
            "nullable": false
          }
        }
      },
      "GetTimeRegistrationsOutputWithTime": {
        "required": [
          "TimeElapsed",
          "Value"
        ],
        "properties": {
          "Value": {
            "$ref": "#/components/schemas/GetTimeRegistrationsOutput"
          },
          "TimeElapsed": {
            "type": "integer"
          }
        }
      },
      "GetHierarchyPresenceTimeOutputWithTime": {
        "required": [
          "TimeElapsed",
          "Value"
        ],
        "properties": {
          "Value": {
            "$ref": "#/components/schemas/GetHierarchyPresenceTimeOutput"
          },
          "TimeElapsed": {
            "type": "integer"
          }
        }
      },
      "GetHierarchyPresenceTimeOutput": {
        "required": [
          "PersonPresenceTimes",
          "TotalPresenceTimeInMinutes"
        ],
        "properties": {
          "TotalPresenceTimeInMinutes": {
            "type": "integer"
          },
          "PersonPresenceTimes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetPersonPresenceTimeOutput"
            }
          }
        }
      },
      "GetPersonPresenceTimeOutputWithTime": {
        "required": [
          "TimeElapsed",
          "Value"
        ],
        "properties": {
          "Value": {
            "$ref": "#/components/schemas/GetPersonPresenceTimeOutput"
          },
          "TimeElapsed": {
            "type": "integer"
          }
        }
      },
      "GetPersonPresenceTimeOutput": {
        "required": [
          "PersonId",
          "FullName",
          "FromDate",
          "ToDate",
          "PresenceTimeInMinutes"
        ],
        "properties": {
          "PersonId": {
            "type": "string"
          },
          "FullName": {
            "type": "string"
          },
          "IsSuccessful": {
            "type": "boolean",
            "nullable": true
          },
          "ErrorCode": {
            "type": "integer",
            "nullable": true
          },
          "Message": {
            "type": "string",
            "nullable": true
          },
          "FromDate": {
            "type": "string",
            "format": "date",
            "example": "2001-01-31"
          },
          "ToDate": {
            "type": "string",
            "format": "date",
            "example": "2001-01-31"
          },
          "PresenceTimeInMinutes": {
            "type": "integer",
            "format": "int32",
            "default": 0
          }
        }
      },
      "GetTimeRegistrationsOutput": {
        "required": [
          "Days"
        ],
        "properties": {
          "Days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DayOutput"
            }
          }
        }
      },
      "DayOutput": {
        "required": [
          "Date",
          "CalculationState"
        ],
        "properties": {
          "Date": {
            "type": "string",
            "format": "date",
            "example": "2001-01-31"
          },
          "CalculationState": {
            "enum": [
              "Successful",
              "Failed"
            ],
            "type": "string",
            "default": "Successful"
          },
          "PresenceTimeInMinutes": {
            "type": "integer",
            "format": "int32",
            "default": 0,
            "nullable": true
          },
          "EndOfDayInMinutes": {
            "type": "integer",
            "format": "int32",
            "default": 1440,
            "nullable": true
          },
          "TimeRegistrations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimeRegistrationOutput"
            },
            "nullable": true
          }
        }
      },
      "TimeRegistrationOutput": {
        "required": [
          "RegistrationTime",
          "RegistrationType",
          "IsManualCorrection",
          "HasReason",
          "Days",
          "IsDeleted"
        ],
        "properties": {
          "RegistrationTime": {
            "type": "string",
            "format": "date-time",
            "example": "2001-01-31T11:55:00"
          },
          "RegistrationType": {
            "enum": [
              "Come",
              "Go"
            ],
            "type": "string",
            "default": "Come"
          },
          "IsManualCorrection": {
            "type": "boolean",
            "default": false
          },
          "HasReason": {
            "type": "boolean",
            "default": false
          },
          "Days": {
            "type": "integer",
            "format": "int32",
            "default": 0
          },
          "IsDeleted": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "VoidResponseOutput": {
        "required": [
          "TimeElapsed"
        ],
        "properties": {
          "TimeElapsed": {
            "type": "integer"
          }
        }
      }
    },
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "timeRegistrations",
      "description": "Operations related to time registrations."
    },
    {
      "name": "timeReports",
      "description": "Operations related to reading calculated time data."
    }
  ]
}